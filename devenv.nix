# SPDX-License-Identifier: MIT
#
# The canonical development environment: `devenv shell`, or `direnv allow`.
#
# `packages` holds tools only. Putting this SDK in it would mean building it
# merely to enter the shell that develops it. The two deliveries are reachable
# lazily through `outputs`, and the packaging route is
# `devenv build outputs.static` / `devenv build outputs.shared` - both evaluate
# the same `package.nix` the flake uses.
#
# No host path, account, store path or `/nix`, `/home` or `/vol` literal appears
# here. Scratch and cache directories are the caller's environment: a value
# exported before a task runs always wins, and nothing here unsets one. Where a
# task needs a location and none was exported, it fills in a default under
# `$XDG_CACHE_HOME` or `$TMPDIR` and never under this repository.
{
  pkgs,
  ...
}:

let
  # nixpkgs derives each Zig attribute from `lib.versions.majorMinor`, so the
  # version 0.16.0 is the attribute `0.16`.
  zig = pkgs.zig_0_16;

  geodc =
    linkage:
    pkgs.callPackage ./package.nix {
      inherit zig;
      inherit linkage;
    };

  static = geodc "static";

  # This module's own directory. `./.` is resolved against the file that writes
  # it, so it names the SDK tree itself and never the caller's working
  # directory. `builtins.toString` is what keeps it a plain path string:
  # `${./.}` copies the whole SDK into the read-only store first, and every
  # task would then run against an immutable copy rather than the working tree
  # the driver's before/after file-set digest covers.
  sdkRoot = builtins.toString ./.;

  # The first lines of every task body, in one place because every task needs
  # them and none of them may differ.
  #
  # The `cd` is not optional. devenv materialises a task as a generated shell
  # program that inherits the caller's working directory, and the way to drive
  # one is `devenv --from path:<sdk> ... tasks run <name>` from a scratch
  # project directory, which holds no `build.zig`, no `UPSTREAM.sha256` and no
  # `consumer/`. Moving the caller's directory into this repository instead
  # would put devenv's own `.devenv` and its autogenerated `devenv.lock` into
  # a working tree whose digests are compared before and after a run.
  #
  # The cache and the prefix are the second half for the same reason: a Zig
  # build resolves both relative to the working directory, and this repository
  # is on a shared volume and is exactly the tree the driver compares. A
  # `ZIG_LOCAL_CACHE_DIR` the caller exported wins and is never overwritten;
  # `GEODC_PREFIX` overrides the prefix alone. With neither a cache root nor an
  # override the task says so and fails, rather than choosing a location this
  # file does not get to invent.
  taskPreamble = ''
    sdkRoot=${pkgs.lib.escapeShellArg sdkRoot}
    cd "$sdkRoot" || exit 1
    if [ -z "''${ZIG_LOCAL_CACHE_DIR:-}" ]; then
      if [ -n "''${XDG_CACHE_HOME:-}" ]; then
        ZIG_LOCAL_CACHE_DIR="$XDG_CACHE_HOME/zig-local-cache"
      elif [ -n "''${TMPDIR:-}" ]; then
        ZIG_LOCAL_CACHE_DIR="$TMPDIR/zig-local-cache"
      else
        echo "geographiclib-c: XDG_CACHE_HOME and TMPDIR are both unset, so no" >&2
        echo "Zig cache and no install prefix are chosen here. Export" >&2
        echo "ZIG_LOCAL_CACHE_DIR at an approved mount." >&2
        exit 1
      fi
      export ZIG_LOCAL_CACHE_DIR
    fi
    if [ -z "''${ZIG_GLOBAL_CACHE_DIR:-}" ]; then
      if [ -n "''${XDG_CACHE_HOME:-}" ]; then
        ZIG_GLOBAL_CACHE_DIR="$XDG_CACHE_HOME/zig"
      elif [ -n "''${TMPDIR:-}" ]; then
        ZIG_GLOBAL_CACHE_DIR="$TMPDIR/zig"
      else
        echo "geographiclib-c: export ZIG_GLOBAL_CACHE_DIR at an approved mount," >&2
        echo "or set XDG_CACHE_HOME or TMPDIR." >&2
        exit 1
      fi
      export ZIG_GLOBAL_CACHE_DIR
    fi
    geodcPrefix="''${GEODC_PREFIX:-$ZIG_LOCAL_CACHE_DIR/geographiclib-c/zig-out}"
  '';
in
{
  packages = [
    zig
    pkgs.coreutils
    pkgs.gnugrep
    pkgs.gnused
    pkgs.jq
  ];

  assertions = [
    {
      # `build.zig.zon` declares `.minimum_zig_version = "0.16.0"` and every Zig
      # shape here was resolved against that compiler's own `lib/std`.
      assertion = zig.version == "0.16.0";
      message = ''
        src/ and zig/ are written against Zig 0.16.0; nixpkgs supplies
        ${zig.version}.
      '';
    }
  ];

  # Lazy: entering the shell does not build the SDK.
  outputs = {
    inherit static;
    shared = geodc "dynamic";
    default = static;
  };

  # One real command per published gate. These are wrappers, not gates: each
  # result belongs to the driver.
  #
  # Every name is `namespace:name`, because that is the only spelling devenv
  # accepts for a task. The dotted form this file used to carry was rejected
  # outright - `Invalid task name: sdk.build` - while the shell was being
  # built, so `devenv shell` failed on `zig version` too. The name is still one
  # attribute and stays quoted whole; `sdk.build = { ... }` would name a task
  # `sdk` and give it an attribute `build`.
  #
  # `"$@"` is on every body, so whatever the invoking shell passes reaches `zig
  # build` without this file enumerating flags, and `--summary all` stays the
  # default it has always been. The bound: devenv's `tasks run` takes task names
  # only and has no trailing-argument escape, so on that CLI `"$@"` is empty.
  # Kept because it is right, not because a task can be shown to take one.
  tasks = {
    "sdk:build" = {
      description = "Install the delivery closure into a prefix outside this repository";
      exec = ''
        ${taskPreamble}
        zig build -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --prefix "$geodcPrefix" --summary all "$@"
      '';
    };

    "sdk:test" = {
      description = "Run the facade tests and every API operation";
      exec = ''
        ${taskPreamble}
        zig build test -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    "sdk:smoke" = {
      description = "Run the deterministic example program";
      exec = ''
        ${taskPreamble}
        zig build smoke -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    "sdk:exercise" = {
      description = "Run every supported facade operation";
      exec = ''
        ${taskPreamble}
        zig build exercise -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    "sdk:upstream-test" = {
      description = "Build and run upstream's own geodtest and geodsigntest C programs";
      exec = ''
        ${taskPreamble}
        zig build upstream-test -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    "sdk:check" = {
      description = "Compile the six-target matrix without running any of it";
      exec = ''
        ${taskPreamble}
        zig build check -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    "sdk:consumer" = {
      description = "Build and run consumer/src/main.zig inside this build graph";
      exec = ''
        ${taskPreamble}
        zig build consumer -j8 --cache-dir "$ZIG_LOCAL_CACHE_DIR" --summary all "$@"
      '';
    };

    # A hash list checked against the tree it was made from: agreement, and
    # nothing else. See UPSTREAM.md, "Integrity". It is the one body with no
    # `zig build` in it, and it needs the same `cd` for the same reason:
    # `sha256sum -c` reads relative paths, so run from anywhere else it reports
    # `UPSTREAM.sha256: No such file or directory` rather than a digest
    # disagreement.
    "sdk:integrity" = {
      description = "Check the recorded digests in UPSTREAM.sha256 against this tree";
      exec = ''
        ${taskPreamble}
        sha256sum -c UPSTREAM.sha256
      '';
    };
  };
}