export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv

# The workspace's own shape, from ../simd/.envrc and ../ocean/.envrc. No
# `source_url`: naming a remote URL for the shell integration would need a
# revision this file cannot read. No scratch, cache or temporary directory is
# set here either - those are the caller's environment.